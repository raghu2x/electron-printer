{
  "name": "@devraghu/electron-printer",
  "version": "2.7.0",
  "private": false,
  "description": "Electron printer plugin for 80mm, 78mm, 76mm, 58mm, 57mm, 44mm printers",
  "keywords": [
    "electron",
    "pos",
    "printer",
    "thermal"
  ],
  "homepage": "https://github.com/raghu2x/electron-printer#readme",
  "bugs": {
    "url": "https://github.com/raghu2x/electron-printer/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Raghvendra Yadav",
    "email": "raghvendraa.dev@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raghu2x/electron-printer.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "playwright test",
    "demo": "electron ./demo/",
    "demo:dist": "bun run build && electron-builder --win",
    "build": "electron-vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "clean": "git clean -fx ./dist",
    "prebuild": "bun run clean",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@devraghu/cashdrawer": "^0.5.0",
    "dompurify": "^3.4.18",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "rolldown-plugin-dts": "^0.30.2",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "electron": ">=30.0.0"
  },
  "engines": {
    "node": ">=26 || ^24 || ^22"
  },
  "packageManager": "bun@1.4.4"
}
